# Copie para .deploy.env (fora do git) e ajuste.
FORCA_HOST=usuario@seu-servidor
FORCA_DOMAIN=financas.exemplo.com
FORCA_EDGE_NETWORK=proxy_default      # rede Docker em que o proxy reverso está
FORCA_REMOTE_DIR=forca
# Opcional, para o deploy adicionar o bloco a um Caddy que já roda no servidor:
# FORCA_CADDY_DIR=/caminho/do/caddy
# FORCA_CADDY_CONTAINER=caddy
